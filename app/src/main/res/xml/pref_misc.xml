<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/root_title" app:key="key_misc_root_access">
        <SwitchPreference
            app:defaultValue="0"
            app:enabled="true"
            app:key="key_misc_dynamic_superuser"
            app:title="@string/dynamic_superuser_title"
            app:summary="@string/dynamic_superuser_summary" />
        <Preference
            app:key="key_misc_securize"
            app:title="@string/securize_title"
            app:summary="@string/securize_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/general_title">
        <SwitchPreference
            app:defaultValue="false"
            app:key="key_misc_virtual_sensors_are_real"
            app:title="@string/virtual_sensors_title"
            app:summary="@string/requires_reboot" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="key_misc_biometricstrong"
            app:title="@string/virtual_sensors_summary"
            app:summary="@string/requires_reboot" />
        <SwitchPreference
            app:defaultValue="0"
            app:key="key_misc_launcher3"
            app:title="@string/set_launcher3_title"
            app:summary="@string/requires_reboot" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="key_misc_disable_sae_upgrade"
            app:title="@string/disable_wpa3_sae_title"
            app:summary="@string/disable_wpa3_sae_summary" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="key_misc_storage_fuse"
            app:title="@string/disable_fuse_storage_title"
            app:summary="@string/disable_fuse_storage_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/display_title">
        <SwitchPreference
            app:defaultValue="false"
            app:key="key_misc_unihertz_dt2w"
            app:title="@string/enable_dt2w_agold_unihertz" />
    </PreferenceCategory>

</PreferenceScreen>